# Local development example. Real values belong in the ignored .env file.

# Auth PostgreSQL
AUTH_DB_NAME=equipmenthub_auth
AUTH_DB_USER=equipmenthub_auth
AUTH_DB_PASSWORD=your_local_db_password
AUTH_DB_URL=jdbc:postgresql://auth-db:5432/equipmenthub_auth
AUTH_DB_PORT=5432

# Gateway and frontend
GATEWAY_PORT=8080
FRONTEND_ORIGIN=http://localhost:3000

# Access JWT
AUTH_ISSUER_URI=http://localhost:8080/auth
AUTH_JWT_SECRET=REPLACE_WITH_BASE64_ENCODED_32_RANDOM_BYTES
AUTH_JWT_AUDIENCE=equipmenthub-api
AUTH_JWT_ACCESS_TOKEN_LIFETIME_SECONDS=600

# Refresh cookie: false for local HTTP, true for HTTPS
AUTH_REFRESH_COOKIE_SECURE=false

# Jenkins: agent secret comes from Jenkins node setup, not GitHub
JENKINS_PORT=8081
JENKINS_AGENT_SECRET=
